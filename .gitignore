# Binary outputs. Anchored to the repo root: an unanchored "vocat-server" also matched the
# cmd/vocat-server source directory, which silently ignored every new file added there.
/vocat-server
/vocat-cli
/ocr_web
/test-clean
/roundtrip-test
/reconvert

# Environment & Secrets
.env
*.pem
*.key
# Generated by the server when VOCAT_SESSION_SECRET is unset
storage/session_secret

# Data & Storage
storage/uploads/*
!storage/uploads/.gitkeep
storage/outputs/*
!storage/outputs/.gitkeep
storage/runs_db.json
storage/runs_db.json.bak*

# Web Node modules & build artifacts
web/node_modules/
web/dist/
web/.vite/

# OS / Editor artifacts
.DS_Store
*.swp
*.tmp
