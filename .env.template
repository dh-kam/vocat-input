# ==============================================================================
# Vocat Auto - Environment Configuration Template
# Copy this file to '.env' and fill in your confidential API keys and settings.
#
# Every variable below is read from the process environment first, then from this
# file. A value set in the environment always wins. Values may contain '=' and may
# be wrapped in quotes; lines starting with '#' are ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for vocat-server backend HTTP daemon (Default: 8080)
PORT=8080

# Shared secret for the web session cookie and the Authorization / X-Vocat-Session
# headers. CHANGE THIS. When unset the server falls back to a value that is public
# in the source and in the built web bundle, which leaves the API unprotected.
VOCAT_SESSION_SECRET=vocat-secret-token-change-this

# ------------------------------------------------------------------------------
# 2. Google Cloud Vertex AI / Gemini Vision Settings
# ------------------------------------------------------------------------------
# GCP Project ID and Region for Vertex AI Multimodal Vision API.
# NOTE: these are ignored on the OCR path whenever an API key below is set, which
# pins the project to a hardcoded value (internal/engine/ocr.go).
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=us-central1

# Google API Key (Alternative to gcloud ADC / OAuth token)
# If provided, used directly for Gemini calls. First non-empty one wins.
VERTEX_API_KEY=your_google_vertex_gemini_api_key_here
# VERTEX_AI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_AI_STUDIO_API_KEY=

# Optional: pre-obtained OAuth token, used when no API key is set.
# Otherwise the server shells out to `gcloud auth print-access-token`.
# GCLOUD_ACCESS_TOKEN=

# Default Gemini model name (e.g., gemini-2.5-flash, gemini-2.5-pro)
VERTEX_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AWS Bedrock Settings (Amazon Nova / Claude Vision)
# ------------------------------------------------------------------------------
# REQUIRED for Bedrock. Both the OCR provider and the AI structuring stage
# authenticate with this bearer token only - there is no AWS SDK in this module, so
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are NOT used and are not listed here.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# AWS Region for the Bedrock runtime endpoint (Default: us-east-1)
AWS_REGION=us-east-1

# Default Bedrock model ID (e.g., amazon.nova-lite-v1:0, amazon.nova-pro-v1:0,
# us.anthropic.claude-sonnet-4-5-20250929-v1:0)
BEDROCK_MODEL=amazon.nova-lite-v1:0

# ------------------------------------------------------------------------------
# 4. Anthropic Claude Settings (Alternative OCR & Structuring Engine)
# ------------------------------------------------------------------------------
# Anthropic API key for the direct Claude vision / structuring path
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model used by the direct Anthropic path
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: alternative Anthropic-compatible endpoint
# ANTHROPIC_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Telegram Integration (Document & DOC Test Sheet Bot Sender)
# ------------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Chat ID / Channel ID where DOC test sheets will be sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 6. Android Debug Bridge (ADB) & Vocat App Automation
# ------------------------------------------------------------------------------
# NOT IMPLEMENTED YET. POST /api/runs/:id/adb-input currently only echoes a word
# count; no Go code reads these two variables. They are kept as a placeholder for
# the automation described in AGENTS.md.
# ADB_DEVICE_ID=
# VOCAT_APP_PACKAGE=kr.co.devstory.vocat
