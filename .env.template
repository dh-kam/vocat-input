# ==============================================================================
# Vocat Auto - Environment Configuration Template
# Copy this file to '.env' and fill in your confidential API keys and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for vocat-server backend HTTP daemon (Default: 8080)
PORT=8080

# Secret key for web authentication session / Bearer token
SESSION_SECRET=vocat-secret-token-change-this

# ------------------------------------------------------------------------------
# 2. Google Cloud Vertex AI / Gemini Vision Settings
# ------------------------------------------------------------------------------
# GCP Project ID and Region for Vertex AI Multimodal Vision API
GCP_PROJECT_ID=c0de1ab-dev-494714
GCP_LOCATION=us-central1

# Google API Key (Alternative to gcloud ADC / OAuth token)
# If provided, used directly for Gemini 2.5 Flash / Pro calls
VERTEX_API_KEY=your_google_vertex_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model name (e.g., gemini-2.5-flash, gemini-2.5-pro)
VERTEX_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AWS Bedrock Settings (Amazon Nova / Claude Vision)
# ------------------------------------------------------------------------------
# AWS Region and Credentials for Bedrock Vision OCR
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Default Bedrock model ID (e.g., amazon.nova-lite-v1:0, amazon.nova-pro-v1:0)
BEDROCK_MODEL=amazon.nova-lite-v1:0

# ------------------------------------------------------------------------------
# 4. Anthropic Claude Settings (Alternative OCR & Structuring Engine)
# ------------------------------------------------------------------------------
# Anthropic API Key for Claude 3.5 Sonnet / Haiku vision fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 5. Telegram Integration (Document & DOC Test Sheet Bot Sender)
# ------------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Chat ID / Channel ID where DOC test sheets will be sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 6. Android Debug Bridge (ADB) & Vocat App Automation
# ------------------------------------------------------------------------------
# Optional: Specific Android device ID for ADB UIAutomator (e.g. emulator-5554)
# If empty, ADB uses default connected device
ADB_DEVICE_ID=

# Vocat Android App package name
VOCAT_APP_PACKAGE=kr.co.devstory.vocat
